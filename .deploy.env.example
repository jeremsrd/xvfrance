# Copier en .deploy.env (non versionné) et compléter.

# Connexion SSH (l'IP de la machine doit être autorisée dans cPanel > Autorisation SSH)
DEPLOY_SSH="utilisateur@serveur.o2switch.net"

# Dossier de l'application sur le serveur ; la racine web du domaine doit pointer sur son sous-dossier public/
DEPLOY_PATH="/home/utilisateur/xvfrance"

# Binaires sur le serveur (version PHP CLI : 8.3 minimum)
DEPLOY_PHP="php"
DEPLOY_COMPOSER="composer"
