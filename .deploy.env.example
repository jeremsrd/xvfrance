# Copier en .deploy.env (non versionné) et compléter.

# Connexion SSH : identifiant cPanel @ domaine
DEPLOY_SSH="identifiant@xvfrance.fr"

# Dossier de l'application sur le serveur ; la racine web du domaine doit pointer sur son sous-dossier public/
DEPLOY_PATH="/home/identifiant/xvfrance"

# API cPanel, pour autoriser l'IP courante en SSH le temps du déploiement
# Jeton : cPanel > Terminal > uapi Tokens create_full_access name=deploy-xvfrance
CPANEL_HOST="xvfrance.fr"
CPANEL_USER="identifiant"
CPANEL_TOKEN=""

# PHP 8.4 en ligne de commande chez O2switch : le binaire /opt/alt/php84 ne lit pas seul
# les extensions choisies dans le sélecteur PHP : PHP_INI_SCAN_DIR pointe sur leur dossier (seul, sinon
# les modules de base sont chargés deux fois)
DEPLOY_PHP="env PHP_INI_SCAN_DIR=/etc/cl.php.d/alt-php84 /opt/alt/php84/usr/bin/php"
DEPLOY_COMPOSER="$DEPLOY_PHP /usr/local/bin/composer"

# Version de PHP du site web, sans toucher à la version par défaut du compte (8.2)
DEPLOY_PHP_HANDLER="application/x-httpd-alt-php84___lsphp"
